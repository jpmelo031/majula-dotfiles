#!/usr/bin/env bash
# Bluetooth menu in Rofi: connect or disconnect paired devices, turn Bluetooth on or off,
# and open Blueman to pair a new device.
set -euo pipefail

menu() {
  rofi -dmenu -i -no-custom -format i -theme-str 'entry { placeholder: "Bluetooth"; }'
}

pair() { setsid -f uwsm app -- blueman-manager >/dev/null 2>&1; }

if ! bluetoothctl show | grep -q 'Powered: yes'; then
  choice=$(printf '%s\n' "Turn on Bluetooth" "Pair a new device" | menu) || exit 0
  case "$choice" in
    0) rfkill unblock bluetooth 2>/dev/null || true
       bluetoothctl power on >/dev/null ;;
    1) pair ;;
  esac
  exit 0
fi

connected=$(bluetoothctl devices Connected | cut -d' ' -f2)
macs=() names=() lines=()
while read -r _ mac name; do
  macs+=("$mac")
  names+=("$name")
  if grep -qx "$mac" <<< "$connected"; then
    lines+=("$name (connected)")
  else
    lines+=("$name")
  fi
done < <(bluetoothctl devices Paired)
lines+=("Pair a new device" "Turn off Bluetooth")

choice=$(printf '%s\n' "${lines[@]}" | menu) || exit 0
[[ $choice =~ ^[0-9]+$ ]] || exit 0   # typed text that matched nothing
n=${#macs[@]}

if (( choice == n )); then
  pair
elif (( choice == n + 1 )); then
  bluetoothctl power off >/dev/null
elif grep -qx "${macs[choice]}" <<< "$connected"; then
  bluetoothctl disconnect "${macs[choice]}" >/dev/null
elif ! timeout 20 bluetoothctl connect "${macs[choice]}" >/dev/null; then
  notify-send -i bluetooth "Bluetooth" "Could not connect to ${names[choice]}"
fi
