/* Rofi Majula: the bonfire theme when the DS2 art is built (see install.sh), else majula */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark-Majula";
    drun-display-format: "{name}";
    display-drun: "";
    display-run: "";
    display-window: "";
    run-command: "uwsm app -- {cmd}";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

@theme "bonfire"
