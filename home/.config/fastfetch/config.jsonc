// Majula fastfetch: the character portrait (kitty graphics) + system info in the theme colors.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/portrait.png",
        "width": 23,
        "height": 10,
        "padding": { "top": 1, "left": 2, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;209;163;92",
            "title": "38;2;224;120;62",
            "output": "38;2;221;214;198",
            "separator": "38;2;70;80;86"
        },
        "key": { "width": 10 },
        "percent": { "type": 9, "color": { "green": "38;2;135;153;109", "yellow": "38;2;209;163;92", "red": "38;2;192;100;82" } }
    },
    "modules": [
        { "type": "title", "color": { "user": "38;2;224;120;62", "host": "38;2;209;163;92" } },
        { "type": "separator", "string": "─" },
        { "type": "os",       "key": "󰣇 os",     "format": "{pretty-name}" },
        { "type": "kernel",   "key": " kernel" },
        { "type": "packages", "key": "󰏖 pkgs" },
        { "type": "wm",       "key": " wm",     "format": "{pretty-name} {version}" },
        { "type": "terminal", "key": " term" },
        { "type": "shell",    "key": " shell" },
        { "type": "cpu",      "key": " cpu",    "format": "{name} ({cores-logical})" },
        { "type": "memory",   "key": "󰍛 ram" },
        { "type": "disk",     "key": "󰋊 disk",   "folders": "/" },
        { "type": "uptime",   "key": "󰅐 uptime" },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 1 },
        "break",
        { "type": "custom", "format": "\u001b[3;38;2;163;155;140m  Bearer... seek... seek... lest...\u001b[0m" }
    ]
}
