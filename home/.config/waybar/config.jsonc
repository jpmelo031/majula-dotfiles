// Majula Waybar: compact floating bar for 1366x768.
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 4,

    "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "backlight", "pulseaudio", "custom/power"],

    "custom/launcher": {
        "format": "",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "persistent-workspaces": { "*": 5 },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 48,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%d/%m/%Y  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#D1A35C'><b>{}</b></span>",
                "weekdays": "<span color='#A39B8C'>{}</span>",
                "today": "<span color='#E0783E'><b>{}</b></span>"
            }
        }
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl -e4 -n2 set 2%+",
        "on-scroll-down": "brightnessctl -e4 -n2 set 2%-",
        "smooth-scrolling-threshold": 2
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"], "headphone": "󰋋" },
        "scroll-step": 5,
        "smooth-scrolling-threshold": 2,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/power-menu"
    }
}
