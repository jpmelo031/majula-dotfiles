        "gitDecoration.modifiedResourceForeground": "#D1A35C",
        "gitDecoration.addedResourceForeground": "#A3B386",
        "gitDecoration.untrackedResourceForeground": "#87996D",
        "gitDecoration.deletedResourceForeground": "#C06452",
        "gitDecoration.conflictingResourceForeground": "#E0783E",
        "gitDecoration.ignoredResourceForeground": "#5C666B",

        "editorGroupHeader.tabsBackground": "#0E1114",
        "editorGroupHeader.tabsBorder": "#20272C",
