        "tab.inactiveBackground": "#0E1114",
        "tab.inactiveForeground": "#7D766A",
        "tab.hoverBackground": "#171C20",
        "tab.border": "#0E1114",
        "tab.unfocusedActiveBorderTop": "#465056",
        "breadcrumb.foreground": "#A39B8C",
        "breadcrumb.focusForeground": "#DDD6C6",
        "breadcrumb.activeSelectionForeground": "#D1A35C",

        "editor.background": "#0E1114",
        "editor.foreground": "#DDD6C6",
        "editorLineNumber.foreground": "#3A4348",
        "editorLineNumber.activeForeground": "#D1A35C",
        "editorCursor.foreground": "#E0783E",
        "editor.lineHighlightBackground": "#171C2099",
        "editor.lineHighlightBorder": "#00000000",
        "editor.selectionBackground": "#D1A35C40",
        "editor.inactiveSelectionBackground": "#D1A35C1F",
        "editor.selectionHighlightBackground": "#D1A35C1F",
        "editor.wordHighlightBackground": "#7899A226",
        "editor.wordHighlightStrongBackground": "#E0783E26",
        "editor.findMatchBackground": "#E0783E59",
        "editor.findMatchHighlightBackground": "#D1A35C33",
        "editor.rangeHighlightBackground": "#20272C80",
        "editorBracketMatch.background": "#D1A35C26",
        "editorBracketMatch.border": "#D1A35C80",
        "editorBracketHighlight.foreground1": "#D1A35C",
        "editorBracketHighlight.foreground2": "#BD9AA8",
        "editorBracketHighlight.foreground3": "#7899A2",
        "editorBracketHighlight.foreground4": "#87996D",
        "editorBracketHighlight.foreground5": "#E0783E",
        "editorBracketHighlight.foreground6": "#8DB8AE",
        "editorIndentGuide.background1": "#1C2226",
        "editorIndentGuide.activeBackground1": "#465056",
        "editorWhitespace.foreground": "#2C3439",
        "editorRuler.foreground": "#20272C",
        "editorCodeLens.foreground": "#5C666B",
        "editorInlayHint.foreground": "#7D766A",
        "editorInlayHint.background": "#171C20",
        "editorError.foreground": "#C06452",
        "editorWarning.foreground": "#E3BB7A",
        "editorInfo.foreground": "#7899A2",
        "editorHint.foreground": "#87996D",
        "editorGutter.addedBackground": "#87996D",
        "editorGutter.modifiedBackground": "#D1A35C",
        "editorGutter.deletedBackground": "#C06452",
        "editorOverviewRuler.border": "#00000000",
        "editorWidget.background": "#171C20",
        "editorWidget.border": "#2C3439",
        "editorSuggestWidget.background": "#171C20",
        "editorSuggestWidget.border": "#2C3439",
        "editorSuggestWidget.selectedBackground": "#D1A35C26",
        "editorSuggestWidget.highlightForeground": "#E0783E",
        "editorHoverWidget.background": "#171C20",
        "editorHoverWidget.border": "#2C3439",
        "peekView.border": "#D1A35C",
        "peekViewEditor.background": "#121619",
        "peekViewResult.background": "#171C20",
        "peekViewTitle.background": "#171C20",
        "diffEditor.insertedTextBackground": "#87996D26",
        "diffEditor.removedTextBackground": "#C0645226",
        "minimap.background": "#0E1114",
        "minimapSlider.background": "#46505633",
        "scrollbarSlider.background": "#46505640",
        "scrollbarSlider.hoverBackground": "#46505673",
        "scrollbarSlider.activeBackground": "#D1A35C66",
        "scrollbar.shadow": "#00000000",

        "input.background": "#171C20",
        "input.foreground": "#DDD6C6",
        "input.border": "#2C3439",
        "input.placeholderForeground": "#5C666B",
        "inputOption.activeBorder": "#D1A35C",
        "inputOption.activeBackground": "#D1A35C26",
        "inputValidation.errorBorder": "#C06452",
        "inputValidation.errorBackground": "#2A1A17",
        "dropdown.background": "#171C20",
        "dropdown.border": "#2C3439",
        "checkbox.background": "#171C20",
        "checkbox.border": "#465056",
        "button.background": "#D1A35C",
        "button.foreground": "#0E1114",
        "button.hoverBackground": "#E3BB7A",
        "button.secondaryBackground": "#20272C",
        "button.secondaryForeground": "#DDD6C6",
        "button.secondaryHoverBackground": "#2C3439",
        "quickInput.background": "#171C20",
        "quickInputList.focusBackground": "#D1A35C26",
        "quickInputList.focusForeground": "#E3BB7A",
        "pickerGroup.foreground": "#E0783E",
        "pickerGroup.border": "#2C3439",
        "keybindingLabel.background": "#20272C",
        "keybindingLabel.foreground": "#DDD6C6",
        "keybindingLabel.border": "#2C3439",
        "keybindingLabel.bottomBorder": "#2C3439",
        "notifications.background": "#171C20",
        "notifications.border": "#2C3439",
        "notificationCenterHeader.background": "#20272C",
        "notificationLink.foreground": "#D1A35C",

        "panel.background": "#0E1114",
        "panel.border": "#20272C",
        "panelTitle.activeForeground": "#E3BB7A",
        "panelTitle.activeBorder": "#E0783E",
        "panelTitle.inactiveForeground": "#7D766A",
        "statusBar.background": "#0E1114",
        "statusBar.foreground": "#A39B8C",
        "statusBar.border": "#20272C",
        "statusBar.noFolderBackground": "#0E1114",
        "statusBar.debuggingBackground": "#E0783E",
        "statusBar.debuggingForeground": "#0E1114",
        "statusBarItem.hoverBackground": "#20272C",
        "statusBarItem.remoteBackground": "#D1A35C",
        "statusBarItem.remoteForeground": "#0E1114",
        "statusBarItem.errorForeground": "#D47A66",
        "statusBarItem.warningForeground": "#E3BB7A",

        "terminal.background": "#0E1114",
        "terminal.foreground": "#DDD6C6",
        "terminalCursor.foreground": "#E0783E",
        "terminal.selectionBackground": "#D1A35C4D",
        "terminal.ansiBlack": "#20272C",
        "terminal.ansiRed": "#C06452",
        "terminal.ansiGreen": "#87996D",
        "terminal.ansiYellow": "#D1A35C",
        "terminal.ansiBlue": "#7899A2",
        "terminal.ansiMagenta": "#A37F8E",
        "terminal.ansiCyan": "#6F9E94",
        "terminal.ansiWhite": "#DDD6C6",
        "terminal.ansiBrightBlack": "#465056",
        "terminal.ansiBrightRed": "#D47A66",
        "terminal.ansiBrightGreen": "#A3B386",
        "terminal.ansiBrightYellow": "#E3BB7A",
        "terminal.ansiBrightBlue": "#94B3BB",
        "terminal.ansiBrightMagenta": "#BD9AA8",
        "terminal.ansiBrightCyan": "#8DB8AE",
        "terminal.ansiBrightWhite": "#F0EADC"
    },
    "tokenColors": [
        { "scope": ["comment", "punctuation.definition.comment", "string.comment"],
          "settings": { "foreground": "#6E777C", "fontStyle": "italic" } },
        { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python"],
          "settings": { "foreground": "#E0783E" } },
        { "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"],
          "settings": { "foreground": "#A39B8C" } },
        { "scope": ["punctuation", "meta.brace", "punctuation.definition.tag"],
          "settings": { "foreground": "#8F887B" } },
        { "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
          "settings": { "foreground": "#A3B386" } },
        { "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"],
          "settings": { "foreground": "#8DB8AE" } },
        { "scope": ["constant.numeric", "constant.language", "constant.language.boolean", "support.constant", "constant.other.color"],
          "settings": { "foreground": "#BD9AA8" } },
        { "scope": ["variable.other.constant", "variable.other.enummember"],
          "settings": { "foreground": "#D47A66" } },
        { "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"],
          "settings": { "foreground": "#D1A35C" } },
        { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "storage.type.class.jsdoc"],
          "settings": { "foreground": "#94B3BB" } },
        { "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"],
          "settings": { "foreground": "#DDD6C6" } },
        { "scope": ["variable.parameter", "meta.parameter"],
          "settings": { "foreground": "#E3BB7A", "fontStyle": "italic" } },
        { "scope": ["variable.language", "variable.language.this", "variable.language.self"],
          "settings": { "foreground": "#E0783E", "fontStyle": "italic" } },
        { "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name"],
          "settings": { "foreground": "#8DB8AE" } },
        { "scope": ["entity.name.tag", "meta.tag.sgml"],
          "settings": { "foreground": "#E0783E" } },
        { "scope": ["entity.other.attribute-name"],
          "settings": { "foreground": "#D1A35C", "fontStyle": "italic" } },
        { "scope": ["entity.name.namespace", "entity.name.module", "support.module"],
          "settings": { "foreground": "#BD9AA8" } },
        { "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator"],
          "settings": { "foreground": "#E3BB7A" } },
        { "scope": ["invalid", "invalid.illegal"],
          "settings": { "foreground": "#C06452" } },
        { "scope": ["markup.heading", "markup.heading entity.name", "punctuation.definition.heading"],
          "settings": { "foreground": "#D1A35C", "fontStyle": "bold" } },
        { "scope": ["markup.bold"], "settings": { "foreground": "#E3BB7A", "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "foreground": "#DDD6C6", "fontStyle": "italic" } },
        { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#8DB8AE" } },
        { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#7899A2" } },
        { "scope": ["markup.list punctuation.definition.list"], "settings": { "foreground": "#E0783E" } },
        { "scope": ["markup.inserted"], "settings": { "foreground": "#A3B386" } },
        { "scope": ["markup.deleted"], "settings": { "foreground": "#C06452" } },
        { "scope": ["markup.changed"], "settings": { "foreground": "#D1A35C" } }
    ],
    "semanticTokenColors": {
        "parameter": { "foreground": "#E3BB7A", "italic": true },
        "property": "#8DB8AE",
        "enumMember": "#D47A66",
        "namespace": "#BD9AA8",
        "type": "#94B3BB",
        "class": "#94B3BB",
        "interface": "#94B3BB",
        "function": "#D1A35C",
        "method": "#D1A35C"
    }
}
